{
  "name": "spruce-react",
  "version": "0.1.4",
  "description": "Spruce React — a themeable React 19 design system with accessible components, design tokens, and an icon registry.",
  "license": "Apache-2.0",
  "author": "Wendell Wayne Estrada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwestrada1217/spruce-ui-react.git"
  },
  "homepage": "https://github.com/wwestrada1217/spruce-ui-react#readme",
  "bugs": {
    "url": "https://github.com/wwestrada1217/spruce-ui-react/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "component-library",
    "ui",
    "typescript",
    "accessible"
  ],
  "type": "module",
  "workspaces": [
    "docs"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/spruce-react.umd.js",
  "module": "./dist/spruce-react.es.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/spruce-react.es.js",
      "require": "./dist/spruce-react.umd.js"
    },
    "./style.css": "./dist/spruce-react.css",
    "./tokens-static.css": "./dist/tokens-static.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm run dev --workspace spruce-react-docs",
    "build": "tsc -b && vite build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "docs:build": "npm run build --workspace spruce-react-docs",
    "docs:preview": "npm run preview --workspace spruce-react-docs",
    "test:type": "tsc -p tests/tsconfig.json --noEmit",
    "test": "npm run build && npm run test:type && node --experimental-strip-types --test tests/tokens.test.mjs tests/theme.test.mjs tests/i18n.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
